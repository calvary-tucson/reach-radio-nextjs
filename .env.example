# Contact Form — Formspree
# Required. Get from https://formspree.io/
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Contact Form — Google reCAPTCHA v3
# Required in production. Get from https://www.google.com/recaptcha/admin
# Omitting this in a non-production environment skips reCAPTCHA verification.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# reCAPTCHA score threshold (0.0–1.0, default 0.5)
# Submissions scoring below this value are rejected as likely bot traffic.
RECAPTCHA_SCORE_THRESHOLD=0.5

# Optional. In-app WebView traffic (detected via an unauthenticated mobile-app
# header/cookie) can produce lower reCAPTCHA v3 scores than a full browser, so it is
# graded against this threshold instead of RECAPTCHA_SCORE_THRESHOLD. Verification
# itself is never skipped for mobile-app traffic — only the passing score differs.
# Falls back to RECAPTCHA_SCORE_THRESHOLD if unset.
RECAPTCHA_SCORE_THRESHOLD_APP=0.3

# Client-side reCAPTCHA site key (public — safe to expose)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
